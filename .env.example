# 复制为 .dev.vars 后填入真实值（.dev.vars 已被 git 忽略）

# 签发登录态 JWT 的密钥，本地可随意填一串长随机字符串
JWT_SECRET=

# Google OAuth 客户端 ID
GOOGLE_CLIENT_ID=

# 允许的跨域来源，本地开发填 http://localhost:5173
ALLOWED_ORIGIN=http://localhost:5173

# 用户 API Key 的加密密钥（生产用 wrangler secret put API_KEY_ENC_SECRET）
API_KEY_ENC_SECRET=

# GitHub OAuth App（可选，回调地址填 http://localhost:5173/）
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
